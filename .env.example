# --- Database (Supabase Postgres) ---
# From your Supabase project: Settings -> Database -> Connection string
# Pooled connection (used by the app at runtime, via pgbouncer on port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (used only for running migrations, port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Supabase (Storage for payment/prize proof screenshots) ---
# From your Supabase project: Settings -> API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
# Public anon key is not currently used server-side but kept for future client-side needs
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="[random-32-byte-secret]"
# Base URL of the app (used for callback URLs)
AUTH_URL="http://localhost:3000"

# --- FPL API ---
FPL_API_BASE_URL="https://fantasy.premierleague.com/api"

# --- Cron ---
# Shared secret checked on incoming requests to /api/cron/* routes.
# Set the same value in your Vercel Cron Job headers (or call manually with this header when self-hosting).
CRON_SECRET="[random-secret]"

# --- First admin account (used only by the seed script) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"
ADMIN_NAME="League Admin"

# --- League defaults (used only by the seed script; editable later in /admin/settings) ---
LEAGUE_CURRENCY="ETB"
