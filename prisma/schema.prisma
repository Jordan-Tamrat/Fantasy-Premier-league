// FPL Private Money League — Phase 1 schema.
// Money fields are always Decimal(10,2), never Float. See services/prizeEngine.ts
// for how ties are split and services/lockGameWeek.ts / finalizeResults.ts for
// how the snapshots below get created and frozen.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum GameWeekStatus {
  DRAFT
  OPEN
  PAYMENT_CLOSED
  LOCKED
  LIVE
  RESULTS_PENDING
  PRIZES_PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  TELEBIRR
  CBE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PrizePaymentStatus {
  PENDING
  PAID
}

enum SnapshotSource {
  API
  MANUAL
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String
  passwordHash     String
  role             Role       @default(MEMBER)
  status           UserStatus @default(ACTIVE)
  telebirrNumber   String?
  cbeAccountNumber String?
  profileImagePath String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  fplAccount        FPLAccount?
  payments          Payment[]             @relation("PayerPayments")
  verifiedPayments  Payment[]             @relation("VerifierPayments")
  participations    GameWeekParticipant[]
  fplSnapshots      FPLGameWeekSnapshot[]
  results           GameWeekResult[]
  prizePaymentsMade PrizePayment[]        @relation("PrizePaidBy")
  invitesSent       Invite[]              @relation("InviteSender")
  auditLogs         AuditLog[]

  chatMessages      ChatMessage[]  @relation("MessageSender")
  deletedMessages   ChatMessage[]  @relation("MessageDeleter")
  chatReactions     ChatMessageReaction[]
  passwordResets       PasswordResetToken[] @relation("PasswordResetUser")
  passwordResetsIssued PasswordResetToken[] @relation("PasswordResetIssuer")
  announcements     Announcement[]
  notifications     Notification[]
  proposals         Proposal[]
  votes             Vote[]
  disputes          Dispute[]      @relation("DisputeAuthor")
  disputesAnswered  Dispute[]      @relation("DisputeResponder")

  @@index([role])
}

// No Account/Session/VerificationToken tables: there are no OAuth providers
// and sessions are JWTs, so Auth.js's database adapter isn't needed here —
// login is just a Credentials check against User.passwordHash.

model Invite {
  id              String       @id @default(cuid())
  email           String
  token           String       @unique
  role            Role         @default(MEMBER)
  status          InviteStatus @default(PENDING)
  invitedByUserId String
  invitedBy       User         @relation("InviteSender", fields: [invitedByUserId], references: [id])
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime?

  @@index([email])
  @@index([status])
}

// Admin-issued password resets, for members who can't use the self-serve
// FPL-Entry-ID flow (typically because they never linked a team). There's no
// email delivery in this app, so the admin generates a one-time link and hands
// it to the member directly, the same way invites are shared.
model PasswordResetToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedById String
  issuedBy   User      @relation("PasswordResetIssuer", fields: [issuedById], references: [id])
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model FPLAccount {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  fplEntryId     Int       @unique
  fplManagerName String?
  fplTeamName    String?
  linkedAt       DateTime  @default(now())
  lastSyncedAt   DateTime?
}

// Singleton row (id is always the literal string "default") holding league-wide
// defaults the admin can edit in /admin/settings.
model LeagueSettings {
  id                                String   @id @default("default")
  leagueName                        String   @default("Fantasy Money League")
  currency                          String   @default("ETB")
  defaultEntryFee                   Decimal  @db.Decimal(10, 2)
  defaultPaymentDeadlineOffsetHours Int      @default(2)
  defaultMinParticipants            Int      @default(3)
  leagueTelebirrNumber              String?
  leagueCbeAccountNumber            String?
  leagueAccountName                 String?
  updatedAt                         DateTime @updatedAt
}

model GameWeek {
  id                         String         @id @default(cuid())
  fplEventId                 Int            @unique
  status                     GameWeekStatus @default(DRAFT)
  entryFee                   Decimal        @db.Decimal(10, 2)
  minParticipants            Int
  paymentDeadlineOffsetHours Int
  fplDeadline                DateTime
  paymentDeadline            DateTime
  announcement               String?        @db.Text
  lockedAt                   DateTime?
  prizeConfigFrozenAt        DateTime?
  collectedAmountSnapshot    Decimal?       @db.Decimal(10, 2)
  finalizedAt                DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  prizePositions PrizePosition[]
  payments       Payment[]
  participants   GameWeekParticipant[]
  fplSnapshots   FPLGameWeekSnapshot[]
  results        GameWeekResult[]

  @@index([status])
}

model PrizePosition {
  id         String   @id @default(cuid())
  gameWeekId String
  gameWeek   GameWeek @relation(fields: [gameWeekId], references: [id])
  position   Int
  amount     Decimal  @db.Decimal(10, 2)

  @@unique([gameWeekId, position])
}

model Payment {
  id               String        @id @default(cuid())
  gameWeekId       String
  gameWeek         GameWeek      @relation(fields: [gameWeekId], references: [id])
  userId           String
  user             User          @relation("PayerPayments", fields: [userId], references: [id])
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  screenshotPath   String
  status           PaymentStatus @default(PENDING)
  submittedAt      DateTime      @default(now())
  verifiedAt       DateTime?
  verifiedByUserId String?
  verifiedBy       User?         @relation("VerifierPayments", fields: [verifiedByUserId], references: [id])
  rejectionReason  String?

  @@unique([gameWeekId, userId])
  @@index([gameWeekId, status])
}

// Immutable snapshot created once, at lockGameWeek() time. Kept separate from
// Payment (which stays a mutable admin-workflow record) so a later change to a
// payment can never retroactively change who was eligible for a past Game Week.
model GameWeekParticipant {
  id                   String   @id @default(cuid())
  gameWeekId           String
  gameWeek             GameWeek @relation(fields: [gameWeekId], references: [id])
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  paymentId            String
  entryFeePaidSnapshot Decimal  @db.Decimal(10, 2)
  snapshotAt           DateTime @default(now())

  @@unique([gameWeekId, userId])
}

model FPLGameWeekSnapshot {
  id               String         @id @default(cuid())
  gameWeekId       String
  gameWeek         GameWeek       @relation(fields: [gameWeekId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  fplEntryId       Int
  points           Int?
  source           SnapshotSource @default(API)
  correctionReason String?
  rawPayload       Json?
  syncedAt         DateTime       @default(now())

  @@unique([gameWeekId, userId])
}

// Frozen award for one participant, written once by finalizeResults().
model GameWeekResult {
  id                     String   @id @default(cuid())
  gameWeekId             String
  gameWeek               GameWeek @relation(fields: [gameWeekId], references: [id])
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  points                 Int
  rank                   Int
  tieGroupSize           Int
  prizePositionsConsumed Int[]
  prizeAwarded           Decimal  @db.Decimal(10, 2)
  roundingAdjustment     Decimal  @db.Decimal(10, 2)
  finalizedAt            DateTime @default(now())

  prizePayment PrizePayment?

  @@unique([gameWeekId, userId])
  @@index([gameWeekId, rank])
}

model PrizePayment {
  id               String             @id @default(cuid())
  gameWeekResultId String             @unique
  gameWeekResult   GameWeekResult     @relation(fields: [gameWeekResultId], references: [id])
  amount           Decimal            @db.Decimal(10, 2)
  status           PrizePaymentStatus @default(PENDING)
  method           PaymentMethod?
  paidAt           DateTime?
  paidByUserId     String?
  paidBy           User?              @relation("PrizePaidBy", fields: [paidByUserId], references: [id])
  proofPath        String?
  referenceNumber  String?
  notes            String?
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  actorLabel  String?
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// --- Phase 2: the parts that replace Telegram ---

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

// There is exactly one league chat room, so there's no ChatRoom model —
// every message belongs to the single shared conversation.
model ChatMessage {
  id             String      @id @default(cuid())
  senderId       String?
  sender         User?       @relation("MessageSender", fields: [senderId], references: [id])
  type           MessageType @default(TEXT)
  content        String      @db.Text
  attachmentPath String?
  replyToId      String?
  replyTo        ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        ChatMessage[] @relation("MessageReplies")
  pinnedAt       DateTime?
  editedAt       DateTime?
  // Soft delete: removed messages stay auditable rather than vanishing.
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?       @relation("MessageDeleter", fields: [deletedById], references: [id])
  createdAt      DateTime    @default(now())

  reactions      ChatMessageReaction[]

  @@index([createdAt])
  @@index([pinnedAt])
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime    @default(now())

  // One row per (message, user, emoji): a person can add several different
  // emojis to a message, but the same emoji only once — so toggling is a
  // create-or-delete on this unique key.
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum NotificationType {
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  GAMEWEEK_OPENED
  GAMEWEEK_LOCKED
  RESULTS_FINAL
  PRIZE_PAID
  PROPOSAL_OPENED
  PROPOSAL_RESOLVED
  ANNOUNCEMENT
  DISPUTE_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Rules live in the database rather than hard-coded. Edits are recorded in
// AuditLog (old + new body), which preserves history without a full
// versioning subsystem.
model RuleSection {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

enum ProposalStatus {
  OPEN
  PASSED
  REJECTED
  IMPLEMENTED
}

enum VoteChoice {
  YES
  NO
}

model Proposal {
  id             String         @id @default(cuid())
  title          String
  description    String         @db.Text
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  status         ProposalStatus @default(OPEN)
  votingDeadline DateTime
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())

  votes Vote[]

  @@index([status])
}

model Vote {
  id         String     @id @default(cuid())
  proposalId String
  proposal   Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  choice     VoteChoice
  createdAt  DateTime   @default(now())

  // One vote per member per proposal, enforced by the database rather than
  // only in application code.
  @@unique([proposalId, userId])
}

enum DisputeCategory {
  PAYMENT
  FPL_SCORE
  ELIGIBILITY
  PRIZE
  RULE
  TECHNICAL
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id            String          @id @default(cuid())
  authorId      String
  author        User            @relation("DisputeAuthor", fields: [authorId], references: [id])
  category      DisputeCategory
  title         String
  description   String          @db.Text
  status        DisputeStatus   @default(OPEN)
  adminResponse String?         @db.Text
  respondedById String?
  respondedBy   User?           @relation("DisputeResponder", fields: [respondedById], references: [id])
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([authorId])
}
